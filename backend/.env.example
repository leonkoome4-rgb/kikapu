# Flask
FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-too

# Database (defaults to local SQLite if unset)
DATABASE_URL=sqlite:///kikapu.db

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# M-Pesa Daraja (sandbox)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://example.com/api/contributions/mpesa/callback

# Notification service (pluggable): console | africastalking | twilio | smtp
SMS_PROVIDER=console
EMAIL_PROVIDER=console

# Africa's Talking (SMS)
AT_USERNAME=sandbox
AT_API_KEY=

# Twilio (SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# SMTP (Email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=notifications@kikapu.app
