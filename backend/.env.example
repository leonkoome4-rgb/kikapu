# Flask
FLASK_APP=main.py
FLASK_ENV=development
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-too

# Database — leave unset for local dev (falls back to a SQLite file next to
# this app); set to a postgres:// URL in production. Use an ABSOLUTE sqlite
# path if you do set one locally (Flask-SQLAlchemy resolves relative sqlite
# URIs against an instance/ folder, not this directory).
# DATABASE_URL=

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# M-Pesa Daraja (sandbox)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://example.com/api/contributions/mpesa/callback

# USSD — the shortcode members dial (issued & routed by Africa's Talking;
# set their callback to <backend-url>/api/ussd)
USSD_CODE=*384*100#

# ngrok — dev only. When set, `python main.py` opens a tunnel to the local
# server (domain: briskness-stingily-stowaway.ngrok-free.dev) and points
# MPESA_CALLBACK_URL at it so Safaricom/Africa's Talking can reach callbacks
# on your machine. Get your token: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# Notification service (pluggable): console | africastalking | twilio | smtp
SMS_PROVIDER=console
EMAIL_PROVIDER=console

# Africa's Talking (SMS)
AT_USERNAME=sandbox
AT_API_KEY=

# Twilio (SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# SMTP (Email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=notifications@kikapu.app
